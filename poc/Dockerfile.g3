# G3 Docker environment for Codex integration with Augani orchestrator
# Persistent container lifecycle for durable plan/worker workspace
# Dashboard accessibility via socat reverse proxy (no upstream modification)
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python-is-python3 git ca-certificates curl socat \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @opencode/cli@2.2.0

# Create non-root user for security
RUN useradd -m -s /bin/bash runner
USER runner
WORKDIR /work

# Dashboard reverse proxy: 0.0.0.0:8080 -> 127.0.0.1:8080
EXPOSE 8080

# Default command keeps container alive for persistent lifecycle
CMD ["sleep", "infinity"]